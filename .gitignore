# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules
node_modules_old/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

# Environment files — never commit real secrets
.env
.env.*
!.env.example

# Prisma query engine binaries (platform-specific, regenerated on install)
prisma/query-engine-*
node_modules/.prisma

# Build output
dist/
build/
.next/
.next_old/

# pnpm store (local cache, not for version control)
.pnpm-store/

# Node.js binary archives
node-v*.tar.*
nodesource_setup.sh

# Phase planning & build stack docs (internal, not for public repo)
phase-*.md
Build Stack For Savi App.md

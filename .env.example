# Application Environment Variables
# Copy this file to .env.development and fill in real values

# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (Supabase) ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET_DO_NOT_USE_IN_PRODUCTION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI Bot (Google Gemini) ──────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ─── Analytics (PostHog) ─────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Storage ─────────────────────────────────────────────
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=savi-uploads-dev
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Payments ────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# ─── Notifications (Brevo & SMS) ─────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
BREVO_API_KEY=xkeysib-...
TERMII_API_KEY=REPLACE_ME

# ─── Maps ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=REPLACE_ME

# ─── Rate Limiting ───────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

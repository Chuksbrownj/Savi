# App Configuration
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Client Settings
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Redis Cache (Upstash)
REDIS_HOST=xxxxxx.upstash.io
REDIS_PORT=30000
REDIS_PASSWORD=your_upstash_password

# Authentication (JWT)
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET_DO_NOT_USE_IN_PRODUCTION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Integration (Google Gemini)
GEMINI_API_KEY=AIzaSy...

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Storage (Cloudflare R2 S3-Compatible)
STORAGE_PROVIDER=s3
AWS_REGION=auto
AWS_S3_BUCKET=savi-uploads-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com

# Payments (Paystack, Flutterwave, Stripe)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Notifications (FCM, Brevo, Termii)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
BREVO_API_KEY=xkeysib-...
TERMII_API_KEY=REPLACE_ME

# Maps Integration
GOOGLE_MAPS_API_KEY=REPLACE_ME

# Rate Limiting Settings
THROTTLE_TTL=60
THROTTLE_LIMIT=100

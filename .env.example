# App Configuration
NODE_ENV=development

# Database and Auth (Supabase)
DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# AI Bot (Google Gemini)
GEMINI_API_KEY=AIzaSy...

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Caching & File Storage (Cloudflare R2)
STORAGE_PROVIDER=cloudflare_r2
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=savi-uploads-dev
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com

# Payments (Flutterwave)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME

# Email (Brevo)
BREVO_API_KEY=xkeysib-...

# Maps Integration (Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_ME
